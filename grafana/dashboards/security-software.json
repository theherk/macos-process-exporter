{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Total Security Software CPU (% of one core)",
      "description": "Combined CPU usage of all Defender + ZScaler processes as a percentage of one CPU core",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "macos-process-exporter-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "none",
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(\n  rate(macos_process_cpu_user_seconds_total{group=\"defender_total\"}[5m])\n  + rate(macos_process_cpu_system_seconds_total{group=\"defender_total\"}[5m])\n) * 100",
          "legendFormat": "Defender",
          "refId": "A"
        },
        {
          "expr": "(\n  rate(macos_process_cpu_user_seconds_total{group=\"zscaler_total\"}[5m])\n  + rate(macos_process_cpu_system_seconds_total{group=\"zscaler_total\"}[5m])\n) * 100",
          "legendFormat": "ZScaler",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] }
      }
    },
    {
      "title": "Defender - CPU by Component (% of one core)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "macos-process-exporter-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(\n  rate(macos_process_cpu_user_seconds_total{group=~\"defender_.*\", group!=\"defender_total\"}[5m])\n  + rate(macos_process_cpu_system_seconds_total{group=~\"defender_.*\", group!=\"defender_total\"}[5m])\n) * 100",
          "legendFormat": "{{group}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "title": "ZScaler - CPU by Component (% of one core)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "macos-process-exporter-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(\n  rate(macos_process_cpu_user_seconds_total{group=~\"zscaler_.*\", group!=\"zscaler_total\"}[5m])\n  + rate(macos_process_cpu_system_seconds_total{group=~\"zscaler_.*\", group!=\"zscaler_total\"}[5m])\n) * 100",
          "legendFormat": "{{group}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "title": "Memory RSS (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "macos-process-exporter-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "macos_process_memory_rss_bytes{group=\"defender_total\"} / 1024 / 1024",
          "legendFormat": "Defender",
          "refId": "A"
        },
        {
          "expr": "macos_process_memory_rss_bytes{group=\"zscaler_total\"} / 1024 / 1024",
          "legendFormat": "ZScaler",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] }
